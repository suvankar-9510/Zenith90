<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer Shield Halo Ring -->
    <path
        android:pathData="M54,22 C71.67,22 86,36.33 86,54 C86,71.67 71.67,86 54,86 C36.33,86 22,71.67 22,54 C22,36.33 36.33,22 54,22 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#282834" />

    <!-- Upward Zenith Peak Arrow (Background Symbol of Ascent) -->
    <path
        android:pathData="M54,28 L74,52 L62,52 L62,74 L46,74 L46,52 L34,52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="28"
                android:endX="54"
                android:endY="74"
                android:type="linear">
                <item android:color="#4084FAB0" android:offset="0.0" />
                <item android:color="#088FD3F4" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bold Stylized "Z" Stroke -->
    <path
        android:pathData="M38,40 L70,40 L40,68 L72,68"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="38"
                android:startY="40"
                android:endX="72"
                android:endY="68"
                android:type="linear">
                <item android:color="#F6D365" android:offset="0.0" />
                <item android:color="#FDA085" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Apex Summit Dot -->
    <path
        android:pathData="M54,28m-3,0a3,3 0 1,1 6,0a3,3 0 1,1 -6,0"
        android:fillColor="#84FAB0" />
</vector>
